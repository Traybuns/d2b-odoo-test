# Copy this file to .env and adjust per environment.
# Contains NO secrets — safe to commit as .env.example.

# Cloud SQL instance connection name: PROJECT:REGION:INSTANCE
CLOUDSQL_INSTANCE_CONNECTION_NAME=d2b-odoo-dev:europe-west1:d2b-cloudsql-odoo-dev

# Postgres role Odoo connects as (created once in Cloud SQL — see README)
ODOO_DB_USER=odoo

# Hostname this deployment serves. For Data2Bots' own use today; when a
# client is onboarded later, this becomes part of a multi-host Traefik rule
# (see the "Onboarding a client" section in README.md).
ODOO_DOMAIN=internal.odoo.data2bots.com
