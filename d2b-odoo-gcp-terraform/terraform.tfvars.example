project_id      = "d2b-dev"
region          = "europe-west4"
zone            = "europe-west4-b"
environment     = "dev"

domain          = "internal.odoo.data2bots.com"

# Use the exact existing Cloud DNS managed-zone name in d2b-odoo-dev.
dns_zone_name   = "REPLACE_WITH_YOUR_CLOUD_DNS_ZONE_NAME"
dns_zone_domain = "odoo-dev.data2bots.com."


vm_machine_type = "e2-standard-4"
vm_disk_size_gb = 100

cloudsql_tier           = "db-custom-2-7680"
cloudsql_disk_size_gb   = 100
cloudsql_postgres_version = "POSTGRES_16"
