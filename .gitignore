# Secrets fetched at deploy time — never commit
secrets/*
!secrets/.gitkeep

# Rendered config (contains the admin master password) — never commit
config/odoo.conf

# Real environment file — commit only .env.example
.env

# Odoo / OS noise
*.pyc
__pycache__/
.DS_Store

terraform.tfvars
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log